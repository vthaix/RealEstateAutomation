# ---- Dữ liệu
RAW_DATA_PATH=data/batches
PROCESSED_DIR=data/processed
ANNOTATIONS_DIR=data/annotations

# ---- Bộ luật (có thể trỏ sang file JSON khác để thử nghiệm)
# EXTRACTION_RULES_PATH=src/realestate/rules/extraction_rules.json
# QUERY_RULES_PATH=src/realestate/rules/query_rules.json

# ---- Trích xuất: rule | bert | hybrid
EXTRACTION_MODE=hybrid
NER_BASE_MODEL=vinai/phobert-base-v2
NER_MODEL_DIR=models/phobert-ner

# ---- Knowledge Graph
KG_PATH=data/kg/graph.pkl
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=realestate123

# ---- LLM Query Parser: auto | llm | rule
QUERY_PARSER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# ---- Xếp hạng
WEIGHTING=priority
LAMBDA_AUX=0.0
MISSING_SOFT_SCORE=0.5
TOP_K=10
