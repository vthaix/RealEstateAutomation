    "legal_status": "IN_SET",
    "property_type": "IN_SET",
    "transaction_type": "EQ",
    "position": "HAS",
    "feature": "HAS"
  },
  "default_group": {
    "_doc": "Nhóm mặc định khi câu không có tín hiệu bắt buộc/linh hoạt. Địa điểm & loại hình nêu trực tiếp được xem là bắt buộc (mục 11.5). Giới hạn trên/dưới (tối đa, dưới...) là bắt buộc.",
    "by_attribute": {
      "location": "HARD",
      "property_type": "HARD",
      "transaction_type": "HARD"
    },
    "by_operator": {
      "LTE": "HARD",
      "GTE": "HARD",
      "RANGE": "HARD",
      "NOT_IN": "HARD"
    },
    "fallback": "SOFT"
  },
  "operator_hardness": {
    "_doc": "Cụm từ giới hạn 'mềm' (trên/dưới/từ/hơn) chỉ coi là HARD nếu không có tín hiệu linh hoạt; 'tối đa/tối thiểu/không quá' luôn HARD.",
    "strong": [
      "tối đa",
      "tối thiểu",
      "không quá",
      "không vượt quá",
      "không dưới",
      "ít nhất",
      "ít ra"
    ]
  },
  "priority_levels": [
    {
      "level": "VERY_HIGH",
      "patterns": [
        "rất quan trọng",
        "cực kỳ quan trọng",
        "quan trọng nhất",
        "rất cần",
        "nhất định phải",
        "rất ưu tiên",
        "ưu tiên hàng đầu",
        "ưu tiên số 1",
        "quan trọng hàng đầu",
        "cực kỳ cần"
      ]
    },
    {
      "level": "HIGH",
      "patterns": [
        "quan trọng",
        "ưu tiên",
        "rất muốn",
        "rất thích",
        "ưu tiên cao"
      ]
    },
    {
      "level": "MEDIUM",
      "patterns": [
        "muốn",
        "mong muốn",
        "thích",
        "hy vọng",
        "lý tưởng",
        "càng tốt",
        "thì càng tốt",
        "càng rộng càng tốt"
      ]
    },
    {
      "level": "LOW",
      "patterns": [
        "thì tốt",
        "có thì tốt",
        "nếu được",
        "nếu có",
        "có thể",
        "cũng được",
        "thêm"
      ]
    },
    {
      "level": "VERY_LOW",
      "patterns": [
        "không quan trọng lắm",
        "sao cũng được",
        "không bắt buộc",
        "có cũng được",
        "tùy",
        "không quan trọng",
        "không cần thiết lắm"
      ]
    }
  ],
  "attribute_value_patterns": [
    {
      "attribute": "bathrooms",
      "regex": "(?:phòng tắm|wc|toilet|nhà vệ sinh|vệ sinh)(?:\\s*(?:thì|có|là|:|khoảng|tầm|ít nhất|tối thiểu|tối đa|có thể|chắc|cũng|từ|trên|dưới|không quá))*\\s*(?<n>\\d{1,2})(?![\\d.,]|\\s*(?:tỷ|triệu|m))"
    },
    {
      "attribute": "bedrooms",
      "regex": "(?:phòng ngủ|pn)(?:\\s*(?:thì|có|là|:|khoảng|tầm|ít nhất|tối thiểu|tối đa|có thể|chắc|cũng|từ|trên|dưới|không quá))*\\s*(?<n>\\d{1,2})(?![\\d.,]|\\s*(?:tỷ|triệu|m))"
    },
    {
      "attribute": "floors",
      "regex": "(?:số tầng|tầng)(?:\\s*(?:thì|có|là|:|khoảng|tầm|ít nhất|tối thiểu|tối đa|có thể|chắc|cũng|từ|trên|dưới|không quá))*\\s*(?<n>\\d{1,2})(?![\\d.,])"
    },
    {
      "attribute": "area",
      "regex": "(?:diện tích|dt|rộng)(?:\\s*(?:thì|có|là|:|khoảng|tầm|ít nhất|tối thiểu|tối đa|có thể|chắc|cũng|từ|trên|dưới|không quá))*\\s*(?<n>{NUM})(?![\\d.,]|\\s*(?:tỷ|triệu|tr|m2|m²|m))"
    },
    {
      "attribute": "price",
      "regex": "(?:giá|ngân sách|tài chính|budget|tiền)(?:\\s*(?:thì|có|là|:|khoảng|tầm|ít nhất|tối thiểu|tối đa|có thể|chắc|cũng|từ|trên|dưới|không quá))*\\s*(?<n>{NUM})\\s*(?<u>tỷ|tỉ|triệu|tr|t)?(?![\\d.,])",
      "unit_default": "tỷ"
    }
  ],
  "location": {
    "_doc": "Địa điểm trong câu truy vấn thường viết thường (quận 3, q7, thủ đức). Ưu tiên khớp gazetteer lấy từ Knowledge Graph; regex dưới đây dùng khi chưa có KG.",
    "regex": "(?<![0-9a-zà-ỹđ])(?:(?<prefix>quận|huyện|phường|xã|thị xã|thị trấn|thành phố|tỉnh|tp\\.?)(?![a-zà-ỹđ])\\s*(?<name>\\d{1,2}(?!\\d)|[a-zà-ỹđ]+(?:\\s[a-zà-ỹđ]+){0,3})|(?<prefix2>q|p)\\.?\\s*(?<num>\\d{1,2})(?!\\d))",
