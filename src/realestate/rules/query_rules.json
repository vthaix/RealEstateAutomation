{
  "_meta": {
    "name": "vi_realestate_query_rules",
    "version": "1.0.0",
    "description": "Luật phân tích câu yêu cầu tìm nhà (fallback khi không có LLM + kiểm tra hậu kỳ kết quả LLM). Giá trị số/thuộc tính được nhận diện bằng extraction_rules.json; file này chỉ chứa luật về toán tử, tính bắt buộc và mức ưu tiên."
  },
  "placeholders": {
    "NUM": "\\d+(?:[.,]\\d+)*",
    "NL": "(?![a-zà-ỹđ])",
    "NB": "(?<![a-zà-ỹđ])",
    "W": "[0-9a-zà-ỹđ_]"
  },
  "clause_split_regex": "\\s*(?:(?<!\\d),|,(?!\\d)|;|\\.(?!\\d)|\\n|\\+|(?<![a-zà-ỹđ])(?:và|nhưng|còn|đồng thời|ngoài ra)(?![a-zà-ỹđ]))\\s*",
