{
  "_meta": {
    "name": "vi_realestate_extraction_rules",
    "version": "1.0.0",
    "description": "Bộ luật trích xuất & chuẩn hóa thuộc tính tin rao BĐS tiếng Việt. Được RuleEngine nạp lúc chạy; sửa file này không cần sửa code.",
    "regex_syntax": "Regex viết theo cú pháp chung Python/JS: nhóm tên dùng (?<name>...) (loader tự đổi sang (?P<name>...) cho Python). Không dùng \\w (khác nhau giữa 2 ngôn ngữ) — dùng {W}. Cờ mặc định: ignore-case + unicode.",
    "placeholders": "{NUM} số có phân cách | {NL} không theo sau bởi chữ cái | {NB} không đứng sau chữ cái | {NDB} không đứng sau chữ số/dấu phân cách | {W} ký tự chữ/số"
  },
  "placeholders": {
    "NUM": "\\d+(?:[.,]\\d+)*",
    "NL": "(?![a-zà-ỹđ])",
    "NB": "(?<![a-zà-ỹđ])",
    "NDB": "(?<!\\d)(?<!\\d[.,])",
    "W": "[0-9a-zà-ỹđ_]",
    "NUMW": "\\d{1,2}|một|hai|ba|bốn|năm|sáu|bảy|tám|chín|mười"
  },
  "number": {
    "thousand_separator_units": [
      "triệu",
      "tr",
      "m2",
      "đồng",
      "vnd",
      "vnđ",
      "nghìn",
      "ngàn"
    ],
    "_doc": "Một dấu phân cách + đúng 3 chữ số + đơn vị trong danh sách -> phân cách hàng nghìn ('1.200 triệu' = 1200). Ngược lại là thập phân ('2,99 tỷ')."
  },
  "money": {
    "patterns": [
      {
        "name": "full_vnd",
        "regex": "{NDB}(?<a>\\d{1,3}(?:[.,]\\d{3}){2,})\\s*(?:đồng|vnđ|vnd|đ){NL}",
        "mode": "number",
        "number_unit": "đồng",
        "multiplier": 1
      },
      {
        "name": "masked",
        "_doc": "Giá che bớt chữ số. Có dấu phân cách hoặc đơn vị tỷ -> phần nguyên ('2.x tỷ' = 2 tỷ, '18x tỷ' = 18 tỷ); đơn vị triệu không phân cách -> giữ hàng ('5xx triệu' = 500 triệu). Luôn coi là xấp xỉ.",
        "regex": "{NDB}(?<a>\\d+(?:[.,]\\d+)?)(?<sep>[.,])?(?<x>x{1,3})\\s*(?<unit>tỷ|tỉ|ty|triệu|tr){NL}",
        "mode": "masked",
        "unit_multipliers": {
          "tỷ": 1000000000,
          "tỉ": 1000000000,
          "ty": 1000000000,
          "triệu": 1000000,
          "tr": 1000000
        },
        "confidence": 0.6
      },
      {
        "name": "ty_trieu",
        "_doc": "8 tỷ 500 triệu",
        "regex": "{NDB}(?<a>\\d+)\\s*(?:tỷ|tỉ|ty)\\s*(?<b>\\d{1,3})\\s*(?:triệu|tr){NL}",
        "mode": "int_plus",
        "multiplier_a": 1000000000,
        "multiplier_b": 1000000
      },
      {
        "name": "ty_short",
        "_doc": "8tỷ5, 8 tỷ 5, 3ty25, 8t5 — 'b' là phần thập phân của tỷ",
        "regex": "{NDB}(?<a>\\d+)\\s*(?<u>tỷ|tỉ|ty|t)\\s*(?<b>\\d{1,3})(?!\\d|[.,]\\d|\\s*(?:m|tầng|tang|lầu|lau|l{NL}|pn|wc|phòng|ngủ|năm|tháng|ngày|km|%|x|căn|lô|tr))",
        "mode": "decimal_join",
        "multiplier": 1000000000,
        "ambiguous_units": [
          "t"
        ],
        "_ambiguous_doc": "'8t5' chỉ là 8,5 tỷ khi ngữ cảnh là giá; không có ngữ cảnh -> độ tin cậy thấp, cần rà soát"
      },
      {
        "name": "ty",
        "regex": "{NDB}(?<a>{NUM})\\s*(?:tỷ|tỉ|ty){NL}",
        "mode": "number",
        "number_unit": "tỷ",
        "multiplier": 1000000000
      },
      {
        "name": "trieu",
        "regex": "{NDB}(?<a>{NUM})\\s*(?:triệu|tr){NL}",
        "mode": "number",
        "number_unit": "triệu",
        "multiplier": 1000000
      }
    ],
    "suffix_regex": "\\s*(?:đồng|vnđ|vnd|đ)?\\s*(?<per>/\\s*(?:m2|m²|m 2|tháng|th|năm|căn|lô|nền|công|sào|ha|m){NL})?",
    "per_unit_roles": [
      {
        "contains": [
          "thang",
          "th",
          "nam"
        ],
        "role": "rent_price",
        "confidence": 0.85
