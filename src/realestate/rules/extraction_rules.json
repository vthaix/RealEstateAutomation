      "regex": "(?:dài|chiều dài|sâu)\\s*:?\\s*(?<n>\\d+(?:[.,]\\d+)?)\\s*m{NL}"
    },
    {
      "label": "BEDROOM",
      "type": "int",
      "min": 1,
      "max": 50,
      "confidence": 0.9,
      "regex": "{NDB}(?<n>{NUMW})\\s*(?:pn|phòng ngủ|phong ngu|p\\.?\\s?ngủ|phòng ngũ|ngủ|bedroom|bedrooms|br|phòng nghỉ){NL}"
    },
    {
      "label": "BEDROOM",
      "type": "int",
      "min": 1,
      "max": 50,
      "confidence": 0.85,
      "_doc": "Phòng ngủ: 3 / số phòng ngủ 3",
      "regex": "(?:phòng ngủ|pn|số phòng ngủ|số pn)\\s*:\\s*(?<n>\\d{1,2})(?![\\d.,])"
    },
    {
      "label": "BATHROOM",
      "type": "int",
      "min": 1,
      "max": 50,
      "confidence": 0.9,
      "regex": "{NDB}(?<n>{NUMW})\\s*(?:wc|toilet|toilets|phòng tắm|phòng vệ sinh|nhà vệ sinh|vệ sinh|vs|nvs|phòng wc|phòng toilet|phòng vs|nhà tắm|wc riêng|toilet riêng|bathroom|bathrooms){NL}"
    },
    {
      "label": "BATHROOM",
      "type": "int",
      "min": 1,
      "max": 50,
      "confidence": 0.85,
      "regex": "(?:wc|toilet|phòng tắm|nhà vệ sinh|phòng vệ sinh|số toilet|số wc|vệ sinh)\\s*:\\s*(?<n>\\d{1,2})(?![\\d.,])"
    },
    {
      "label": "FLOOR",
      "type": "int",
      "min": 1,
      "max": 100,
      "confidence": 0.85,
      "regex": "{NDB}(?<n>\\d{1,2})\\s*(?:tầng|tang|tấm|lầu|tầng lầu){NL}"
    },
    {
      "label": "FLOOR",
      "type": "int",
      "min": 1,
      "max": 100,
      "confidence": 0.6,
      "meta": {
        "floor_level": true
      },
      "_doc": "'tầng 15' (vị trí căn hộ) khác '15 tầng' (số tầng)",
      "regex": "(?:tầng|lầu)\\s+(?:số\\s+)?(?<n>\\d{1,2})(?![\\d.,]|\\s*(?:tầng|lầu|m))"
    }
  ],
  "floor_composite": {
    "_doc": "1 trệt 2 lầu -> 3 tầng ; 1T2L ; trệt, lửng, 2 lầu ; 1 trệt 1 lửng 3 lầu",
    "regex": "(?:(?<t>\\d)\\s*)?(?:trệt|tret|t)\\s*(?:,|\\+|và|-)?\\s*(?:(?<lung>\\d?)\\s*(?:lửng|lung|gác lửng)\\s*(?:,|\\+|và|-)?\\s*)?(?<l>\\d{1,2})\\s*(?:lầu|lau|l){NL}",
    "require_any": [
      "trệt",
      "tret",
      "^\\d?\\s*t\\s*\\d{1,2}\\s*l$"
    ],
    "count_mezzanine": false,
    "confidence": 0.9
  },
