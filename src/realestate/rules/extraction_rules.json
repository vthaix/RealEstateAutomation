    "_after_doc": "after_other khớp theo ranh giới từ (tránh 'vốn' khớp trong 'triển vọng')."
  },
  "area": {
    "regex": "{NDB}(?<n>{NUM})\\s*(?<u>m2|m²|m 2|mét vuông|met vuong|ha|hecta|héc ta|sào){NL}",
    "unit_multipliers": {
      "ha": 10000,
      "hecta": 10000,
      "héc ta": 10000,
      "sào": 360
    },
    "context_window": 35,
    "kind_cues": {
