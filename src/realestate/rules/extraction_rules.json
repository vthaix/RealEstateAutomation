    "confidence": 0.85
  },
  "dimensions": {
    "_doc": "4x15m, 4 x 12m, 5mx20m, (4,5 x 18) -> chiều ngang (nhỏ hơn) và chiều dài",
    "regex": "(?<![\\d.,a-zà-ỹ])(?<w>\\d+(?:[.,]\\d+)?)\\s*(?:m\\s*)?[x×*]\\s*(?<l>\\d+(?:[.,]\\d+)?)(?:\\s*m(?![a-z0-9²]))?",
    "max_width": 200,
    "max_length": 500,
    "confidence": 0.75
  },
  "numeric_entities": [
    {
      "label": "FRONTAGE",
      "unit": "m",
      "type": "float",
      "min": 0.5,
      "max": 500,
      "confidence": 0.85,
      "regex": "(?:ngang|chiều ngang|mặt tiền|mặt tiền rộng|mt|mặt tiền khủng|ngang rộng)\\s*:?\\s*(?<n>\\d+(?:[.,]\\d+)?)\\s*m{NL}"
